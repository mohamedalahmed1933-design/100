local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- إنشاء واجهة تحكم بسيطة (تشغيل / إيقاف)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PreciseAutoClicker"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Size = UDim2.new(0, 160, 0, 50)
ToggleBtn.Position = UDim2.new(0, 40, 0, 40)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 16
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.Text = "Smart Auto: OFF"
ToggleBtn.Active = true
ToggleBtn.Draggable = true
ToggleBtn.Parent = ScreenGui

local active = false
local canClick = true

ToggleBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ToggleBtn.Text = "Smart Auto: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "Smart Auto: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- حلقة تتبع مستمرة ودقيقة
task.spawn(function()
    while true do
        task.wait(0.005) -- فحص فائق السرعة لمتابعة الخط الأبيض بدقة
        if active then
            local foundBar = false
            
            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                -- البحث عن الإطار الرمادي الخاص بشريط الميني جيم
                if gui:IsA("Frame") and gui.AbsoluteSize.X > 250 and gui.AbsoluteSize.Y < 60 then
                    foundBar = true
                    local absPos = gui.AbsolutePosition
                    local absSize = gui.AbsoluteSize
                    
                    -- محاكاة موقع الضغط في منتصف الشريط (أو يمكنك تخصيص إحداثيات السهم بدقة)
                    local clickX = absPos.X + (absSize.X / 2)
                    local clickY = absPos.Y + (absSize.Y / 2)
                    
                    -- المنطق التلقائي المستمر لكل ضربة مطلوبة
                    if canClick then
                        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
                        task.wait(0.02)
                        VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
                        
                        canClick = false
                        -- مهلة قصيرة لمنع التكرار المفرط في نفس اللحظة حتى يستعد للضربة التالية
                        task.spawn(function()
                            task.wait(0.3)
                            canClick = true
                        end)
                    end
                    break
                end
            end
            
            -- إذا انتهت الميني جيم أو اختفى الشريط، أعد السماح بالنقر فوراً
            if not foundBar then
                canClick = true
            end
        end
    end
end)
