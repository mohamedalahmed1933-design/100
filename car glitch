local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- إنشاء واجهة تحكم بسيطة (زر تشغيل وإيقاف)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoMiniGameGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Size = UDim2.new(0, 150, 0, 50)
ToggleBtn.Position = UDim2.new(0, 40, 0, 40)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 18
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.Text = "Auto-Click: OFF"
ToggleBtn.Active = true
ToggleBtn.Draggable = true
ToggleBtn.Parent = ScreenGui

local active = false

ToggleBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ToggleBtn.Text = "Auto-Click: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "Auto-Click: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- حلقة المراقبة والضغط التلقائي
task.spawn(function()
    while true do
        task.wait(0.01) -- فحص سريع جداً لتجنب تفويت الهدف
        if active then
            -- ابحث عن إطار أو شريط اللعبة في الـ PlayerGui
            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                -- التحقق من خصائص الشريط بناءً على شكل اللعبة
                if gui:IsA("Frame") and gui.AbsoluteSize.X > 250 and gui.AbsoluteSize.Y < 60 then
                    -- محاكاة الضغط بالماوس أو الشاشة عند مطابقة الشرط
                    local absPos = gui.AbsolutePosition
                    local absSize = gui.AbsoluteSize
                    
                    -- محاكاة النقر في منتصف الشريط أو موقع السهم الحالي
                    local clickX = absPos.X + (absSize.X / 2)
                    local clickY = absPos.Y + (absSize.Y / 2)
                    
                    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
                    task.wait(0.3) -- مهلة قصيرة بين الهجمات لكي تتوافق مع "Hits left"
                    break
                end
            end
        end
    end
end)
