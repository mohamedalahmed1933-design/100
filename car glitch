import pyautogui
import keyboard
import time

# إحداثيات وألوان التتبع
# ملاحظة: قم بتحديد منطقة الشاشة التي يوجد بها الشريط الرمادي والأخضر
# اللون الأخضر الموضح في الصورة (RGB)
TARGET_GREEN = (0, 230, 0) # درجة اللون الأخضر
TOLERANCE = 40 # نسبة التسامح في اختلاف درجات اللون

is_running = False

print("=== سكربت التتبع البصري الذكي ===")
print("اضغط على الزر F6 لتشغيل / إيقاف التتبع الذكي")
print("اضغط على الزر Esc لإغلاق البرنامج نهائياً")

def is_color_match(c1, c2, tolerance):
    return all(abs(c1[i] - c2[i]) <= tolerance for i in range(3))

while True:
    # مفتاح التشغيل والإيقاف (F6)
    if keyboard.is_pressed('f6'):
        is_running = not is_running
        print(f"حالة الذكاء الاصطناعي: {'مفعل' if is_running else 'متوقف'}")
        time.sleep(0.3)

    if keyboard.is_pressed('esc'):
        print("تم إغلاق البرنامج.")
        break

    if is_running:
        # قراءة موقع الماوس أو المنطقة المحددة للشريط
        x, y = pyautogui.position()
        current_color = pyautogui.pixel(x, y)

        # إذا اكتشف الذكاء الاصطناعي اللون الأخضر تحت المؤشر مباشرة
        if is_color_match(current_color, TARGET_GREEN, TOLERANCE):
            pyautogui.click()
            time.sleep(0.3) # مهلة لمنع التكرار المفرط للضربة

    time.sleep(0.005) # سرعة فحص عالية جداً
