-- ضع هذا السكربت في StarterPlayerScripts كـ LocalScript
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- تغيير الـ CameraOffset
-- القيمة الأولى (0): يمين/يسار
-- القيمة الثانية (-3): هي المسؤولة عن إنزال الكاميرا (كلما زاد الرقم بالسالب نزلت أكثر)
-- القيمة الثالثة (10): هي بُعد الكاميرا عن السيارة
humanoid.CameraOffset = Vector3.new(0, -3, 10)
