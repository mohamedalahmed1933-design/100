local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PreciseClickerGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Size = UDim2.new(0, 160, 0, 50)
ToggleBtn.Position = UDim2.new(0, 40, 0, 40)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 16
ToggleBtn.Font = Enum.Font.SourceSansBold
ToggleBtn.Text = "Auto: OFF"
ToggleBtn.Active = true
ToggleBtn.Draggable = true
ToggleBtn.Parent = ScreenGui

local active = false
local hasClicked = false

ToggleBtn.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ToggleBtn.Text = "Auto: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "Auto: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        hasClicked = false
    end
end)

task.spawn(function()
    while true do
        task.wait(0.005)
        if active then
            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                if gui:IsA("Frame") and gui.AbsoluteSize.X > 250 and gui.AbsoluteSize.Y < 60 then
                    local barPos = gui.AbsolutePosition.X
                    local barSize = gui.AbsoluteSize.X
                    
                    for _, sub in ipairs(gui:GetDescendants()) do
                        if sub:IsA("Frame") and sub.AbsoluteSize.X < 15 and sub.AbsoluteSize.Y >= gui.AbsoluteSize.Y - 10 then
                            local needlePos = sub.AbsolutePosition.X
                            
                            local greenStart = barPos + (barSize * 0.4)
                            local greenEnd = barPos + (barSize * 0.7)
                            
                            if needlePos >= greenStart and needlePos <= greenEnd then
                                if not hasClicked then
                                    local clickX = barPos + (barSize / 2)
                                    local clickY = gui.AbsolutePosition.Y + (gui.AbsoluteSize.Y / 2)
                                    
                                    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
                                    task.wait(0.02)
                                    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
                                    
                                    hasClicked = true
                                end
                            else
                                if needlePos < greenStart - 10 or needlePos > greenEnd + 10 then
                                    hasClicked = false
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)
