local player = game:GetService("Players").LocalPlayer

local function setupCamera(character)
    local humanoid = character:WaitForChild("Humanoid")
    
    -- يراقب متى تجلس وتقوم
    humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
        if humanoid.Sit and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            -- الرقم -2.5 هو اللي ينزل الكاميرا تحت لمستوى الشنطة زي الصورة
            humanoid.CameraOffset = Vector3.new(0, -2.5, 0)
        else
            -- يرجع الكاميرا لوضعها الطبيعي فوراً إذا نزلت
            humanoid.CameraOffset = Vector3.new(0, 0, 0)
        end
    end)
end

-- تشغيل السكربت أول ما تدخل اللعبة وكل ما تموت وترسبن
if player.Character then
    setupCamera(player.Character)
end
player.CharacterAdded:Connect(setupCamera)
